BOT_EQUITY_INTERVAL=1Day
BOT_CRYPTO_INTERVAL=1d

# Scheduler — cron expressions in UTC
BOT_DAILY_REPORT_CRON="0 7 * * *"
BOT_WEEKLY_DIGEST_CRON="0 8 * * 1"
BOT_ALERT_SCAN_INTERVAL=300

# Send the daily report immediately every time the bot starts (restarts / deploys).
# Set to false to suppress on dev machines where you don't want a report on every reload.
BOT_REPORT_ON_STARTUP=true
# Seconds to wait after on_ready before sending the startup report.
BOT_REPORT_ON_STARTUP_DELAY=30

# Alert thresholds (all configurable for future web-app control panel)
BOT_RSI_OVERSOLD=30
BOT_RSI_OVERBOUGHT=70
BOT_VIX_ALERT_THRESHOLD=25
BOT_BB_SQUEEZE_ALERT=true
BOT_ALERT_COOLDOWN_SECS=14400

# Redis cache TTLs (seconds)
BOT_CACHE_PRICE_TTL=300
BOT_CACHE_ANALYZE_TTL=600
BOT_CACHE_DAILY_REPORT_TTL=3600

# Report formatting
BOT_NEWS_HEADLINES_LIMIT=5
BOT_REPORT_MAX_SYMBOLS=10

# Telegram (future — leave empty until implemented)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Correlation Analysis Thresholds ───────────────────────────────────────────
# Minimum conditions (out of 5) for the Bullish Convergence master signal to fire.
# Higher = more conservative / fewer false positives. Range: 2–5.
CORR_BULLISH_CONVERGENCE_MIN_CONDITIONS=3

# Minimum conditions (out of 4) for the Value Trap master signal.
CORR_VALUE_TRAP_MIN_CONDITIONS=3

# Minimum conditions (out of 4) for the Leverage Cycle Warning master signal.
CORR_LEVERAGE_CYCLE_MIN_CONDITIONS=3

# Receivables growth ratio multiplier for the Deterioration Warning signal.
# If accounts_receivable growth rate > revenue growth rate × this → flag.
# 1.1 = receivables growing 10% faster than revenue triggers the flag.
CORR_RECEIVABLES_GROWTH_MULTIPLIER=1.1

# ── Macro Analysis — Monetary Policy Thresholds ───────────────────────────────
# How often the macro-analysis worker re-computes signals (default 6h).
DATA_MACRO_ANALYSIS_POLL_INTERVAL=6h
# Seconds to wait after startup before first run — lets data-equity finish its
# initial FRED fetch so macro_fred is populated before the first analysis pass.
# Set to 0 when running against a pre-populated database.
DATA_MACRO_ANALYSIS_STARTUP_DELAY_SECS=300

# Yield Curve (T10Y2Y spread in percentage points)
# >1.0pp = steep (expansion), 0–1.0pp = normal, 0 to -0.5pp = flat, <-0.5pp = inverted.
# Re-steepening detection: was at or below YC_INVERTED and rose by ≥ YC_RESTEEPENING_BPS.
MACRO_YC_STEEP_THRESHOLD=1.0
MACRO_YC_FLAT_THRESHOLD=0.0
MACRO_YC_INVERTED_THRESHOLD=-0.5
MACRO_YC_RESTEEPENING_BPS=0.5
MACRO_YC_LOOKBACK_DAYS=90

# Real Interest Rate (DFII10 — 10Y TIPS yield, in %)
# Deeply negative: assets bubble risk. Headwind: drag on growth stocks and gold.
MACRO_REAL_RATE_DEEPLY_NEGATIVE=-2.0
MACRO_REAL_RATE_HEADWIND=2.0

# Fed Balance Sheet (WALCL — 4-week change threshold, in billions USD)
# Change > +100Bn/4w = QE signal. Change < -100Bn/4w = QT signal.
MACRO_BS_EXPAND_THRESHOLD_BN=100
MACRO_BS_CONTRACT_THRESHOLD_BN=100

# Credit Spreads (BAMLH0A0HYM2 — HY OAS, in basis points)
# <300bps benign. 300–600bps elevated (risk-off). >600bps crisis.
MACRO_HY_ELEVATED_BPS=300
MACRO_HY_CRISIS_BPS=600

# Breakeven Inflation (T10YIE — 10Y rate, in %)
# <2.5% = anchored (Fed comfortable). 2.5–3.0% = rising risk. >3.0% = unanchored.
MACRO_BREAKEVEN_RISING_PCT=2.5
MACRO_BREAKEVEN_UNANCHORED_PCT=3.0

# M2 Money Supply YoY growth rate regime boundaries (%)
# >15% inflationary surge. 4–15% normal. <0% deflationary pressure.
MACRO_M2_INFLATIONARY_PCT=15
MACRO_M2_NORMAL_MIN_PCT=4

# Composite Monetary Policy Stance score boundaries (-1 to +1)
# Score > accommodative threshold = "accommodative". Score < restrictive = "restrictive".
MACRO_MP_ACCOMMODATIVE_SCORE=0.4
MACRO_MP_RESTRICTIVE_SCORE=-0.4

# ── Macro Analysis — Growth Cycle Thresholds ──────────────────────────────────
# How often the growth analysis pass runs (monthly data — no need to run hourly).
DATA_MACRO_GROWTH_POLL_INTERVAL=12h

# ISM Manufacturing PMI (NAPM — monthly, index value)
# >55 strong expansion | 50–55 moderate | 45–50 slowing | <45 contraction | <40 severe
GROWTH_PMI_STRONG=55
GROWTH_PMI_EXPANSION=50
GROWTH_PMI_SLOW=45
GROWTH_PMI_SEVERE=40

# Conference Board LEI — 6-month annualized rate of change (%)
# Below -3% with broad weakness = high recession probability.
GROWTH_LEI_EXPANSION_RATE=0.0
GROWTH_LEI_RECESSION_RATE=-3.0

# Initial Jobless Claims (ICSA — weekly, persons)
# 4-week MA used to smooth volatility. Values as whole numbers.
GROWTH_CLAIMS_TIGHT=225000
GROWTH_CLAIMS_NORMALIZING=300000
GROWTH_CLAIMS_CRISIS=500000

# Housing Starts (HOUST — monthly, annualized thousands of units)
# >1500K strong | 1000–1500K moderate | <800K severe contraction (2009 low: 478K)
GROWTH_HOUSING_STRONG=1500
GROWTH_HOUSING_WEAK=800

# Real GDP (GDPC1 — quarterly, annualized %)
# >3% strong | 1–3% moderate | 0–1% stall speed | <0% recession
GROWTH_GDP_STRONG=3.0
GROWTH_GDP_STALL=1.0

# Nonfarm Payrolls (PAYEMS — monthly, thousands added)
# >200K strong | 75–200K moderate | <0 recession signal
GROWTH_NFP_STRONG=200
GROWTH_NFP_MODERATE=75

# Sahm Rule recession indicator threshold (pp above 12-month low)
# >=0.5 = recession historically already underway
GROWTH_SAHM_THRESHOLD=0.5

# Real Retail Sales YoY % (RRSFS)
# >3% healthy | 0–3% slowing | <0% consumer recession
GROWTH_RETAIL_HEALTHY=3.0

# University of Michigan Consumer Sentiment (UMCSENT)
# <60 historically near market bottoms | >100 + VIX <12 = complacency
GROWTH_UMICH_BOTTOM=60
GROWTH_UMICH_COMPLACENCY=100

# Core Capex 3-month trend direction threshold (%)
# 3-month rolling change: >+3% = business expansion | < -3% = warning
GROWTH_CAPEX_EXPANSION=3.0
GROWTH_CAPEX_WARNING=-3.0

# Composite Growth Stance score boundaries (-1 to +1)
GROWTH_EXPANSION_SCORE=0.4
GROWTH_CONTRACTION_SCORE=-0.4

# ── Macro Analysis — Inflation & Prices Thresholds ────────────────────────────
# How often the inflation analysis pass runs (monthly releases — no need to run hourly).
DATA_MACRO_INFLATION_POLL_INTERVAL=12h

# ── CPI (CPIAUCSL — monthly, stored as index level; YoY % computed) ───────────
# Goldilocks: 1.5–2.5% | Above target: 2.5–4% | Hot: >5% | Deflation: <0%
INFLATION_CPI_GOLDILOCKS_MAX=2.5
INFLATION_CPI_ABOVE_TARGET=4.0
INFLATION_CPI_HOT=5.0

# ── Core PCE (PCEPILFE — monthly, Fed's actual target metric) ─────────────────
# At target: <2.2% | Hawkish bias: 2.2–3.0% | Aggressive tightening: >3.0%
INFLATION_CORE_PCE_AT_TARGET=2.2
INFLATION_CORE_PCE_HAWKISH=3.0

# ── Core CPI (CPILFESL — monthly, ex food & energy) ──────────────────────────
INFLATION_CORE_CPI_TARGET=2.5
INFLATION_CORE_CPI_HOT=4.0

# ── PPI (PPIFID — monthly final demand; PPIACO — all commodities) ─────────────
# PPI typically leads CPI by 3–6 months.
# PPI-CPI spread >3pp = corporate margin pressure (watch for earnings misses).
INFLATION_PPI_SURGE=8.0
INFLATION_PPI_ELEVATED=4.0
INFLATION_PPI_CPI_SPREAD_WARNING=3.0

# ── WTI Crude Oil (DCOILWTICO — daily, $/barrel) ──────────────────────────────
# Goldilocks: $60–80 | Inflationary: $80–100 | Demand destruction: >$100 | Stress: <$50
# A $10/barrel move shifts US headline CPI by ~0.3–0.4pp.
INFLATION_WTI_GOLDILOCKS_MIN=60
INFLATION_WTI_GOLDILOCKS_MAX=80
INFLATION_WTI_INFLATIONARY=100
INFLATION_WTI_STRESS=50

# ── Average Hourly Earnings (CES0500000003) / ECI (ECIALLCIV — quarterly) ─────
# Wage growth target-consistent: 3–3.5% | Above target: 3.5–4.5% | Spiral risk: >5%
# ECI is the Fed's preferred wage measure (less volatile than AHE).
INFLATION_WAGE_TARGET_MAX=3.5
INFLATION_WAGE_ELEVATED=4.5
INFLATION_WAGE_SPIRAL=5.0

# ── Copper (PCOPPUSDM — monthly, $/metric ton) ────────────────────────────────
# Copper is a real-time barometer of global industrial demand (China = 55% of demand).
# YoY > +10% = global expansion | YoY < -10% = global contraction signal
INFLATION_COPPER_EXPANSION_YOY=10.0
INFLATION_COPPER_CONTRACTION_YOY=-10.0

# ── Composite Inflation Stance score boundaries (-1 to +1) ───────────────────
# Score > hot threshold = inflationary (Fed hawkish, bonds sell off, defensives outperform)
# Score < deflation threshold = deflationary (demand collapse, bonds rally, gold outperforms)
INFLATION_HOT_SCORE=0.4
INFLATION_DEFLATION_SCORE=-0.4

# ── Macro Analysis — Global & Geopolitical ─────────────────────────────────────
# FRED: DTWEXBGS (broad USD), DEXJPUS (USD/JPY), CHNGDPNQDSMEI (China GDP), FYFSD, GDP
GLOBAL_DOLLAR_SUPPORTIVE_MAX=95
GLOBAL_DOLLAR_NEUTRAL_MAX=100
GLOBAL_DOLLAR_HEADWIND_MAX=105
GLOBAL_DOLLAR_STRESS_MIN=110
GLOBAL_USDJPY_EARLY_UNWIND_PCT=-5.0
GLOBAL_USDJPY_SYSTEMIC_UNWIND_PCT=-10.0
GLOBAL_USDJPY_LOOKBACK_OBS=22
GLOBAL_CHINA_GDP_CONTRACT=3.0
GLOBAL_CHINA_GDP_STABLE=5.0
GLOBAL_CHINA_GDP_EXPANSION=6.0
GLOBAL_FISCAL_MANAGEABLE_PCT=3.0
GLOBAL_FISCAL_ELEVATED_PCT=6.0
GLOBAL_STRESS_ELEVATED_SCORE=0.35
GLOBAL_STRESS_BENIGN_SCORE=-0.15

# ── Bar-source candidates (Phase 1 evaluation — NOT yet wired to any worker) ──
# Yahoo is §2.2's designated primary because it serves CONSOLIDATED volume, which
# every §3 volume feature (RVOL, acceleration, dollar volume) depends on. It is
# currently unusable from the corporate network: a blanket HTTP 429 that is IP
# reputation, not rate limiting, so no rate setting fixes it.
#
# These four authenticate by API KEY, so they meter per account rather than per
# egress IP — which sidesteps that failure mode entirely and is the more durable
# fix even if Yahoo recovers. All four were confirmed REACHABLE from the blocked
# network (they return auth errors, not IP blocks).
#
# Setting a key here wires nothing up. No adapter exists yet, and none should be
# written until this passes for the chosen provider:
#
#   ./services/data-ingestion/scripts/verify-bar-source.sh all
#
# STILL UNVERIFIED for every one of them: free-tier daily-bar availability,
# history depth, rate limits at ~5,000 symbols, and above all whether the volume
# is CONSOLIDATED or single-venue. A fallback quietly supplying IEX-scale volume
# would leave the whole scanner confidently wrong — the exact problem that
# disqualified Alpaca's free tier in §2.2.
TIINGO_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
EODHD_API_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# Shared API rate budgets — migration 008_api_rate_budget.sql
# ══════════════════════════════════════════════════════════════════════════════
# Every worker builds its own in-process token bucket, so N workers sharing one
# API key permit N times the intended rate. Five Go workers hold a Finnhub client
# at ~0.5 req/s each = ~2.5 req/s against a free-tier budget of 1 req/s (60/min).
#
# Harmless so far only because observed demand is ~10% of budget. It stops being
# harmless when one caller saturates its allowance for hours (the scanner's
# universe-wide fundamentals pass) — the 429s then appear in whichever OTHER
# worker happens to be running, putting symptom and cause in different services.
#
# Coordination state lives in Postgres, which every worker already depends on, so
# this adds no new failure surface. If coordination fails the worker falls back to
# its own in-process bucket — i.e. today's behaviour — never to unlimited, and
# never blocking. Watch for "shared rate limiter unavailable" at warn level.
FINNHUB_SHARED_RATE_ENABLE=true
# Finnhub free tier is 60 requests/minute = 1.0/sec, shared across ALL workers.
FINNHUB_RATE_PER_SEC=1.0
FINNHUB_RATE_BURST=2.0

# How long one shared acquisition may take before degrading to the local bucket.
# Deliberately short: the fallback is safe, a stalled worker is not.
SHARED_RATE_ACQUIRE_TIMEOUT=250ms
# Cap on a single enforced wait, so a misconfigured budget cannot park a worker.
SHARED_RATE_MAX_SLEEP=5s
# Throttles the degradation warning; the counter records every occurrence.
SHARED_RATE_WARN_EVERY=30s

# ══════════════════════════════════════════════════════════════════════════════
# Momentum scanner (Phase 1) — docs/MOMENTUM_SCANNER_PHASE1.md
# ══════════════════════════════════════════════════════════════════════════════

# ── data-fundamental — universe-wide metrics pass (§8.4, step 3b) ─────────────
# Widens ONLY runMetrics to the eligible universe. market_cap and
# shares_outstanding — the two fields §3.2's gate and §3.9's proxy need — come
# from that one sub-task; the other seven keep iterating FUNDAMENTAL_SYMBOLS
# untouched. Sector is NOT obtainable this way (Alpha Vantage is 25 req/DAY, a
# 200+ day pass) and stays null in Phase 1 at zero cost to the score — see §3.13.
#
# 'env'          static FUNDAMENTAL_SYMBOLS only (default; existing behaviour)
# 'env+universe' UNION of that list and universe_symbols WHERE is_eligible.
#                Union, never replacement: FUNDAMENTAL_SYMBOLS contains SPY, an
#                ETF that §3.1 excludes from the universe, so replacing the list
#                would silently drop the most visible symbol in the daily report.
# SWITCHED to env+universe on 2026-09-21 for the post-upgrade validation.
# 'env' alone covers only the static watchlist, which leaves the eligible
# universe without market_cap and shares_outstanding — and a symbol with no
# market cap cannot be assigned a §3.2 bucket, so it is never gated or scored.
# FUNDAMENTAL_METRICS_SCOPE controls how wide 'universe' reaches; this controls
# whether the universe is consulted at all. Both are required.
FUNDAMENTAL_METRICS_SYMBOL_SOURCE=env+universe
# Route the widened pass through fundamental_fetch_state so a ~3.3-hour pass
# survives a restart. Without it the pass re-walks the universe every tick.
# Which slice of the universe the widened metrics pass covers.
#   selected  the pilot draw only (universe_symbols.backfill_selected) — ~450
#             symbols, ~15 min at the shared 1 req/sec Finnhub budget
#   eligible  the full §3.1 eligible universe — ~4,975 symbols, ~3.3 hours
#
# Defaults to 'selected' because Step 7 evaluates the draw and nothing else, so
# the wide pass would spend hours on ~4,500 symbols that take no part in the
# evaluation. Widen only once the pilot has shown the scoring approach is worth
# extending — the same sequencing §2.2 applies to paying for data.
#
# Restricts BOTH symbol resolution and checkpoint seeding: scoping only the
# former would leave ~4,500 permanently-pending rows that the checkpointed pass
# would work through anyway. An unrecognised value is an error, not a fallback.
# WIDENED to 'eligible' on 2026-09-21. The pilot has run, and the post-upgrade
# validation evaluates the full universe, so every eligible symbol now needs
# market_cap and shares_outstanding — without them §3.2 cannot assign a bucket,
# and a symbol with no bucket cannot be gated or scored at all.
FUNDAMENTAL_METRICS_SCOPE=eligible
FUNDAMENTAL_METRICS_UNIVERSE_CHECKPOINTED=true
# The widened pass gets its OWN cadence rather than inheriting
# DATA_FUNDAMENTAL_METRICS_POLL_INTERVAL (24h): at ~3.3h per pass, daily would
# spend ~23h of API budget a week, against §2.3/§8.1.2 which specify weekly.
FUNDAMENTAL_METRICS_UNIVERSE_POLL_INTERVAL=168h
# How stale a symbol's last SUCCESS may be before it is claimable again. This,
# not a reset job, is what makes the weekly cadence emergent.
FUNDAMENTAL_METRICS_UNIVERSE_REFRESH_INTERVAL=168h
FUNDAMENTAL_METRICS_UNIVERSE_BATCH_SIZE=250
# A claim older than this is treated as abandoned by a killed worker.
FUNDAMENTAL_METRICS_UNIVERSE_CLAIM_LEASE=30m
FUNDAMENTAL_METRICS_UNIVERSE_MAX_ATTEMPTS=3
FUNDAMENTAL_METRICS_UNIVERSE_IDLE_INTERVAL=1h

# ── data-universe — eligible US common-stock universe (§3.1, §8.1) ────────────
# Weekly symbol-list refresh + weekly sector/shares/market-cap refresh.
# Needs FINNHUB_API_KEY (declared above) for the symbol list; without it that
# pass is skipped with a warning and the worker keeps running.
UNIVERSE_ENABLE_SYMBOLS=true
# REMOVED 2026-09-21 (migration 020). The universe fundamentals pass wrote
# universe_symbols.shares_outstanding / .market_cap / .fundamentals_ts, which
# nothing read, and its latest-row query picked a NULL-by-design row for 59% of
# symbols. Deleted rather than fixed: a broken write path with no consumers is a
# trap for whoever wires one up later. Read equity_fundamentals directly, with
# the canonical NULL-last + fundamental_source_rank ordering.
# UNIVERSE_ENABLE_FUNDAMENTALS=<removed>
# Finnhub /stock/symbol exchange code. "US" returns the whole US listing in one call.
UNIVERSE_EXCHANGE=US
UNIVERSE_SYMBOLS_POLL_INTERVAL=168h
UNIVERSE_FUNDAMENTALS_POLL_INTERVAL=168h
UNIVERSE_STARTUP_DELAY_SECS=30

# §3.1 eligibility. Blank means "spec default", never "allow nothing".
# Types: strict common-stock reading. Add "ADR" / "REIT" here to widen — the
# spec names only common stock, so widening is a deliberate choice, not a fix.
UNIVERSE_ALLOWED_TYPES="Common Stock"
# MICs for NASDAQ (incl. tier codes), NYSE, NYSE American. ARCX (NYSE Arca) and
# every OTC venue are deliberately absent — §3.1 excludes OTC/pink sheets.
UNIVERSE_ALLOWED_MICS=XNAS,XNGS,XNMS,XNCM,XNYS,XASE
# Non-common share-class suffixes, matched after a '.' or '-'. Preferred series
# (-P, -PA, -PB, …) are handled by a prefix rule and need no entry here.
# Share-class letters (BRK.B) are intentionally NOT excluded.
UNIVERSE_EXCLUDED_SUFFIXES=W,WS,WT,U,UN,R,RT
# Finnhub occasionally omits the MIC. Default false: an unverifiable venue
# cannot satisfy an allowlist.
UNIVERSE_ALLOW_EMPTY_MIC=false

# §3.1/§3.2 minimum daily bars. 252, because §3.7's 52-week window reads
# high[t-251] and a complete window therefore needs 252 bars including today.
# Lowering this reintroduces silently truncated 52-week windows.
#
# Recorded and reported by data-universe but NOT used to set is_eligible — the
# backfill iterates the eligible set, so gating eligibility on bar count would be
# circular. Enforced as a hard gate at scan time instead (§3.2).
UNIVERSE_MIN_BARS_HISTORY=252

# Which equity_ohlcv rows count as the scanner's daily bars (§7), and the source
# value the scanner reads back by. An unrecognised value fails at startup.
#
# Tiingo, not Alpaca: Alpaca's free tier is IEX-only volume, a single-venue
# fraction of consolidated volume, which would make RVOL, volume acceleration
# and dollar volume all wrong. Not Yahoo either: it is NOT dividend-adjusted
# (indicators.adjclose is never decoded), so it does not satisfy §3.
UNIVERSE_BAR_INTERVAL=1Day
UNIVERSE_BAR_SOURCE=tiingo

# ── Tiingo: PRIMARY bar provider ─────────────────────────────────────────────
# Chosen for CORRECTNESS, not speed. It is the only source verified to apply one
# consistent adjustment factor across a whole series. twelve_data is 9x faster
# but alternates between adjusted and unadjusted bars WITHIN a single response,
# fabricating one-day moves up to +1382% across 12-17% of symbols and 41% of the
# penny bucket (see internal/barquality and `go run ./cmd/bar-audit`).
#
# Published and measured limits (Tiingo Starter, free):
#   50 requests / hour   HARD, resets on the clock hour (measured: blocked
#                        05:54 UTC, recovered 06:01 UTC -> fixed clock)
#   1,000 requests / day resets midnight EST
#   500 unique symbols / month  (re-reading a counted symbol is free)
#
# UPGRADED to Power 2026-09-21 ($30/mo). Measured: 179 requests in 111s with
# zero 429s, against 51-74 on the free tier — the 50/hour ceiling is gone.
#
# Documented Power limits: 10,000/hour, 100,000/day, ~108,980 unique
# symbols/month, 40 GB/month. Configured below those on purpose:
#   2.0/sec  = 7,200/hour  against 10,000/hour
#   90,000/day              against 100,000/day
# A 4,975-symbol backfill is ~42 minutes at this pace, versus ~9 hours for 450
# symbols on the free tier.
TIINGO_SHARED_RATE_ENABLE=true
TIINGO_RATE_PER_SEC=2.0
TIINGO_RATE_BURST=5.0
TIINGO_RATE_DAILY_LIMIT=90000

# Hard guard asserted by the subset-selection job before it writes.
#
# NOT PREVIOUSLY SET HERE — the job ran on its code default, so the effective cap
# was invisible from .env. Made explicit because a limit that only exists in a Go
# literal is one nobody checks when they change the plan.
#
# Raised from 450 to 6000 on 2026-09-21: the 450 was Tiingo's free-tier
# 500-unique-symbols/month cap, and Power allows ~108,980. Eligible universe is
# 4,975 today. The assertion stays to catch an order-of-magnitude mistake.
TIINGO_MAX_SELECTED_SYMBOLS=6000

# ── Bar-fetch HTTP knobs (apply to whichever UNIVERSE_BAR_SOURCE names) ──────
# Previously named UNIVERSE_YAHOO_*, which is how Twelve Data silently inherited
# Yahoo's 30s timeout and failed 12 symbols on "Client.Timeout exceeded while
# awaiting headers" — a 3-year daily response is ~100KB and this link is lossy.
# The UNIVERSE_YAHOO_* names still work as fallbacks.
UNIVERSE_BAR_TIMEOUT=90s
UNIVERSE_BAR_MAX_RETRIES=3
UNIVERSE_BAR_BACKOFF_BASE=2s
UNIVERSE_BAR_BACKOFF_MAX=60s
UNIVERSE_BAR_BURST=1
# Per-provider pacing lives in TWELVE_DATA_RATE_PER_SEC / TIINGO_RATE_PER_SEC;
# this generic value applies only to yahoo_finance.
UNIVERSE_BAR_REQUESTS_PER_SEC=2.0

# ── Twelve Data: PRIMARY bar provider (§2.2) ─────────────────────────────────
# Measured on this account 2026-09-17: 8 credits/minute, enforced with an
# explicit 429 that names the count ("9 API credits were used, with the current
# limit being 8"). 800 requests/day is the published figure.
TWELVE_DATA_SHARED_RATE_ENABLE=true
# 0.1333/s is 8/min exactly. 0.125/s (7.5/min) leaves a margin so clock skew
# against Twelve Data's own minute boundary cannot push a burst one over.
TWELVE_DATA_RATE_PER_SEC=0.125
TWELVE_DATA_RATE_BURST=1.0
# PADDED BELOW the documented 800 on purpose: the window boundary is an
# assumption, and overrunning the account is worse than a spurious quota error,
# which the backfill checkpoint handles gracefully.
TWELVE_DATA_RATE_DAILY_LIMIT=750

# ── Universe pricing: bucketing signal for stratification (§8.1.1) ───────────
# Finnhub /quote across the whole eligible universe (~83 min at 1 req/sec), so
# the stratified draw has real bucket data without spending Tiingo quota.
# /quote is a live snapshot, not an adjusted close: LoadSubsetStats flags any
# symbol whose post-backfill bucket disagrees with its selection-time bucket.
UNIVERSE_PRICING_ENABLE=true
UNIVERSE_PRICE_INTERVAL=quote_snapshot
UNIVERSE_PRICE_SOURCE=finnhub_quote

# ── Momentum alert thresholds — CALIBRATED, not carried over (§4.4) ──────────
# The original 60/100 was set against §4 v1's weight table, where breakout and
# high52w contributed up to 25 points. Under v2 those are zeroed, the allocated
# ceiling is 90, and the practical ceiling is 75 while catalyst_tier is null —
# so 60 no longer means what it meant.
#
# Measured against the 218 historical pilot candidates, 60 fires on 34.4% of
# them (the 66th percentile) for a lift of only 1.20x. In the penny bucket it is
# worse than useless: penny's median score is 62, so >=60 selects candidates that
# hit LESS often than the penny base rate (0.91x lift).
#
# Thresholds are therefore per bucket, set at each bucket's own 90th percentile:
#
#   bucket   base rate   median   p90   n>=p90   hit%    lift
#   market   10.30%      53       65    21       14.29   1.39x
#   penny    32.08%      62       72     9       44.44   1.39x
#
# ~30 alerts over 18 months of pilot history, i.e. under two a month, which is a
# scanner rather than a feed.
#
# IN-SAMPLE: these percentiles come from the same candidates §4.1 v2 was derived
# from. Recalibrate when the universe widens.

# ── Momentum scanner channels (§8.3) ─────────────────────────────────────────
# Four channels: bucket x side. An unset ID logs a warning and posts nothing —
# it never crashes the bot, and a partial rollout (market configured, penny not)
# is a normal intermediate state.
DISCORD_PENNY_BUY_CHANNEL_ID=
DISCORD_PENNY_SELL_CHANNEL_ID=
DISCORD_MARKET_BUY_CHANNEL_ID=
DISCORD_MARKET_SELL_CHANNEL_ID=

# Off by default: momentum_score_100 is research-stage (only rvol is
# statistically validated), so posting to channels is an explicit opt-in rather
# than something that starts on upgrade.
# screener | score.
#
# screener (default): alerts fire on a §3.2 gate pass, per bucket, and carry NO
# score. This is the honest claim — the gates are a real, reproducible filter.
# score: restores the 65/72 threshold behaviour. NOT recommended. Those are
# percentile cut points on momentum_score_100, which does not separate outcomes
# within a bucket out-of-sample (MH OR 0.991, p=0.947), so the threshold selects
# an arbitrary tenth of candidates while implying it is the best tenth.
BOT_MOMENTUM_ALERT_MODE=screener

# Max screener alerts posted per channel per day; 0 disables the cap.
# Gate passes are bursty: over ten years the mean is 4.5/day and the median 3,
# but the p90 is 9 and the worst day produced 157: 2024-11-06, the session after
# the US election. (NOT a 2020 day — an earlier note misattributed it. 2020's
# busiest day was 41. The distinction matters because it must not be read into
# the separate "2020 supplies 37% of positives" finding.) A 157-message burst is
# unreadable, and it arrives exactly on the days a reader most wants to skim.
# Overflow is summarised in one "…and X more — see /scanner" line rather than
# dropped silently, so a truncated day cannot look like a quiet one.
BOT_MOMENTUM_MAX_ALERTS_PER_CHANNEL=10

BOT_MOMENTUM_SCAN_ENABLE=false

# §8.3: one alert per symbol per bucket per 5 sessions, so a name that stays
# qualified for a week does not alert daily.
BOT_MOMENTUM_COOLDOWN_SECS=432000

BOT_MOMENTUM_MIN_SCORE_MARKET=65
BOT_MOMENTUM_MIN_SCORE_PENNY=72

# ── Pilot subset (§2.2, migration 010) ───────────────────────────────────────
# TURNED OFF 2026-09-21. This flag means "restrict all work to the pilot
# subset", and it existed because Tiingo's free tier metered 500 unique symbols
# per month. Power allows ~108,980, so the constraint is gone and the backfill
# now claims the full eligible universe (4,975).
#
# UNIVERSE_SUBSET_SIZE / _SEED below are left at their pilot values on purpose:
# they document how the 450 were drawn. The cohort's IDENTITY no longer depends
# on them, or on backfill_selected, which the selection routine clears on every
# run -- it is frozen in momentum_pilot_cohort (migration 013) with content hash
# 718ea0e2d6c9d67f63e1c8206ffcc298, because those 450 are in-sample for score v2
# and every out-of-sample claim depends on telling them apart.
UNIVERSE_SUBSET_ENABLE=false
UNIVERSE_SUBSET_STRATEGY=stratified
UNIVERSE_SUBSET_SIZE=450
UNIVERSE_SUBSET_PENNY_FLOOR_PCT=0.20
UNIVERSE_SUBSET_PENNY_MIN_PRICE=0.30
UNIVERSE_SUBSET_PENNY_MAX_PRICE=2.00
# Set, not empty: the pilot's numbers get cited, so the draw must be reproducible.
UNIVERSE_SUBSET_SEED=phase1-pilot
UNIVERSE_SUBSET_SYMBOLS=
# Redrawing is opt-in. UNIVERSE_SUBSET_ENABLE means "restrict work to the pilot
# subset" and stays on for the whole pilot; without this separate flag every
# restart reselected. With a fixed seed that is only wasted work, but with an
# empty seed it silently draws a DIFFERENT sample and spends a second batch of
# Tiingo's 500 unique symbols/month — and the row count is 450 either way.
UNIVERSE_SUBSET_RESELECT=false

# ── data-universe — resumable bar backfill (§8.1.3) + daily refresh (§8.1.4) ──
UNIVERSE_ENABLE_BACKFILL=true
UNIVERSE_ENABLE_DAILY_BARS=true

# History depth. RAISED 3 -> 10 on 2026-09-21; §2.3 updated to match.
#
# Phase 2 needs purged walk-forward validation with a 120-session label horizon.
# Three years of bars leaves roughly 1.5 years of candidates whose labels have
# matured, which is not enough to cut into honest folds — the label window eats
# the tail, and what remains is one market regime.
#
# Ten years also spans several regimes (2016-19 expansion, the 2020 crash and
# recovery, the 2021 small-cap mania, the 2022 drawdown, 2023-26). A rule fitted
# inside a single regime is indistinguishable from a rule that describes it.
#
# Cost of the change, measured rather than assumed: ~2.25 GB against the 40
# GB/month Power allowance (5.6%), from a 20-symbol probe.
#
# The longer window makes SURVIVORSHIP BIAS WORSE, not better, because today's
# eligible universe excludes everything that delisted over those ten years. See
# §2.3 — hit rates are reported by calendar year so the bias stays visible.
UNIVERSE_BACKFILL_YEARS=10
# Symbols claimed per round. Bounded so a crash loses at most one batch of
# in-flight claims and so progress is logged regularly across a long run.
UNIVERSE_BACKFILL_BATCH_SIZE=200
# Parallel in-flight fetches. The rate limiter is shared, so this controls
# pipelining, not throughput — raising it will not exceed the rate below.
UNIVERSE_BACKFILL_CONCURRENCY=4
# How long an in_progress claim is honoured before another round may reclaim it.
# This is what makes a killed worker's rows recoverable instead of stranded.
UNIVERSE_BACKFILL_CLAIM_LEASE=15m
# Retries per symbol across runs. Beyond this the symbol stays 'failed' and is
# reported rather than retried forever — check backfill_last_error.
UNIVERSE_BACKFILL_MAX_ATTEMPTS=3
# Wait before re-checking for work once a round finds none.
UNIVERSE_BACKFILL_IDLE_INTERVAL=1h

# Yahoo request behaviour. §2.3 budgets ~5 req/s, but the chart endpoint is
# unofficial and §2.2 says to rate-limit politely and treat it as best-effort.
# 2/s sustains a ~6k-symbol pass in well under an hour; above ~5/s expect 429s.
UNIVERSE_YAHOO_REQUESTS_PER_SEC=2.0
UNIVERSE_YAHOO_BURST=1
UNIVERSE_YAHOO_TIMEOUT=30s
UNIVERSE_YAHOO_MAX_RETRIES=3
UNIVERSE_YAHOO_BACKOFF_BASE=2s
UNIVERSE_YAHOO_BACKOFF_MAX=60s

# Daily incremental refresh. Runs on weekdays at UNIVERSE_DAILY_BARS_AT (New
# York time, after Tiingo's EOD bars are final), and once at startup when fewer
# than UNIVERSE_DAILY_BARS_CATCHUP_SHARE of backfilled symbols have the latest
# due session. No holiday calendar: a holiday pass returns no new bars. Set
# UNIVERSE_DAILY_BARS_AT=interval for the old plain UNIVERSE_DAILY_BARS_INTERVAL
# ticker. The lookback is wider than one day on purpose: it repairs gaps from a
# missed run or a late provider correction, and upserts make the overlap free.
UNIVERSE_DAILY_BARS_AT=18:30
UNIVERSE_DAILY_BARS_CATCHUP_SHARE=0.95
UNIVERSE_DAILY_BARS_INTERVAL=24h
UNIVERSE_DAILY_BARS_LOOKBACK_DAYS=7

# ── SEC EDGAR (Phase 2 §3.2, point-in-time shares) ───────────────────────────
# SEC requires a descriptive User-Agent identifying the requester with a
# contact address. It is an env var rather than a literal because it carries a
# real contact address, and because the value below is the single thing that
# decides whether requests succeed.
#
# SEC DENYLISTS SOME CONTACT DOMAINS. A UA containing
# `users.noreply.github.com` returns 403 while the IDENTICAL UA with a real
# domain returns 200, and a UA with no email at all also returns 200. The 403
# body is titled "Request Rate Threshold Exceeded" or "Your Request Originates
# from an Undeclared Automated Tool", so it points at rate limiting and bot
# detection rather than at the address. Use a real domain you control.
SEC_EDGAR_USER_AGENT="YourProjectName admin@yourdomain.example"
# SEC's documented fair-access rate is ~10 req/s. Set below it on purpose: the
# published rate is PER IP, and this network egresses through a shared proxy
# (a shared corporate proxy), so our share of that allowance
# is not ours to assume.
SEC_EDGAR_RATE_PER_SEC=3.0
SEC_EDGAR_TIMEOUT=60s
