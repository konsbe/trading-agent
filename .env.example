# ══════════════════════════════════════════════════════════════════════════════
# Shared API rate budgets — migration 008_api_rate_budget.sql
# ══════════════════════════════════════════════════════════════════════════════
# Every worker builds its own in-process token bucket, so N workers sharing one
# API key permit N times the intended rate. Five Go workers hold a Finnhub client
# at ~0.5 req/s each = ~2.5 req/s against a free-tier budget of 1 req/s (60/min).
#
# Harmless so far only because observed demand is ~10% of budget. It stops being
# harmless when one caller saturates its allowance for hours (the scanner's
# universe-wide fundamentals pass) — the 429s then appear in whichever OTHER
# worker happens to be running, putting symptom and cause in different services.
#
# Coordination state lives in Postgres, which every worker already depends on, so
# this adds no new failure surface. If coordination fails the worker falls back to
# its own in-process bucket — i.e. today's behaviour — never to unlimited, and
# never blocking. Watch for "shared rate limiter unavailable" at warn level.
FINNHUB_SHARED_RATE_ENABLE=true
# Finnhub free tier is 60 requests/minute = 1.0/sec, shared across ALL workers.
FINNHUB_RATE_PER_SEC=1.0
FINNHUB_RATE_BURST=2.0

# ── Per-provider shared budgets (migration 010 adds the daily dimension) ────
# Tiingo: no daily ceiling. Its constraint is 500 UNIQUE SYMBOLS PER MONTH, which
# a rate limiter structurally cannot express — re-reading a known symbol is free.
# Enforcement is therefore the selected-subset size, not this budget. The rate
# below is politeness only (~1.7 req/s was observed without throttling).
TIINGO_SHARED_RATE_ENABLE=true
TIINGO_RATE_PER_SEC=0.0138
TIINGO_RATE_BURST=1.0
# Hard guard asserted by the subset-selection job. Nothing else prevents someone
# widening the pilot past Tiingo's monthly allowance; exceeding it fails a month
# later, for reasons that look unrelated to the change that caused them.
TIINGO_MAX_SELECTED_SYMBOLS=450

# Twelve Data: 8 requests/minute AND 800 credits/day. The DAILY cap binds first —
# 800 credits at 8/min is ~100 minutes of work, then blocked until the window
# rolls. 8/min = 0.1333/sec.
TWELVE_DATA_SHARED_RATE_ENABLE=true
TWELVE_DATA_RATE_PER_SEC=0.125
TWELVE_DATA_RATE_BURST=1.0
# PADDED BELOW the documented 800 on purpose. The UTC-midnight window boundary is
# an assumption, not a verified fact; being wrong in the "more room than we
# thought" direction overruns the account, while a spurious quota error is handled
# gracefully by the backfill checkpoint. Raise to 800 only after SyncDailyUsage
# has reconciled against /api_usage across a real rollover.
TWELVE_DATA_RATE_DAILY_LIMIT=750

# How long one shared acquisition may take before degrading to the local bucket.
# Deliberately short: the fallback is safe, a stalled worker is not.
SHARED_RATE_ACQUIRE_TIMEOUT=250ms
# Cap on a single enforced wait, so a misconfigured budget cannot park a worker.
SHARED_RATE_MAX_SLEEP=5s
# Throttles the degradation warning; the counter records every occurrence.
SHARED_RATE_WARN_EVERY=30s

# ══════════════════════════════════════════════════════════════════════════════
# Momentum scanner (Phase 1) — docs/MOMENTUM_SCANNER_PHASE1.md
# ══════════════════════════════════════════════════════════════════════════════

# ── Bar-source candidates (Phase 1 evaluation — NOT yet wired to any worker) ──
# Yahoo is §2.2's designated primary because it serves CONSOLIDATED volume, which
# every §3 volume feature (RVOL, acceleration, dollar volume) depends on. It is
# currently unusable from the corporate network: a blanket HTTP 429 that is IP
# reputation, not rate limiting, so no rate setting fixes it.
#
# These four authenticate by API KEY, so they meter per account rather than per
# egress IP — which sidesteps that failure mode entirely and is the more durable
# fix even if Yahoo recovers. All four were confirmed REACHABLE from the blocked
# network (they return auth errors, not IP blocks).
#
# Setting a key here wires nothing up. No adapter exists yet, and none should be
# written until this passes for the chosen provider:
#
#   ./services/data-ingestion/scripts/verify-bar-source.sh all
#
# STILL UNVERIFIED for every one of them: free-tier daily-bar availability,
# history depth, rate limits at ~5,000 symbols, and above all whether the volume
# is CONSOLIDATED or single-venue. A fallback quietly supplying IEX-scale volume
# would leave the whole scanner confidently wrong — the exact problem that
# disqualified Alpaca's free tier in §2.2.
TIINGO_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
EODHD_API_KEY=


# ── data-fundamental — universe-wide metrics pass (§8.4, step 3b) ─────────────
# Widens ONLY runMetrics to the eligible universe. market_cap and
# shares_outstanding — the two fields §3.2's gate and §3.9's proxy need — come
# from that one sub-task; the other seven keep iterating FUNDAMENTAL_SYMBOLS
# untouched. Sector is NOT obtainable this way (Alpha Vantage is 25 req/DAY, a
# 200+ day pass) and stays null in Phase 1 at zero cost to the score — see §3.13.
#
# 'env'          static FUNDAMENTAL_SYMBOLS only (default; existing behaviour)
# 'env+universe' UNION of that list and universe_symbols WHERE is_eligible.
#                Union, never replacement: FUNDAMENTAL_SYMBOLS contains SPY, an
#                ETF that §3.1 excludes from the universe, so replacing the list
#                would silently drop the most visible symbol in the daily report.
FUNDAMENTAL_METRICS_SYMBOL_SOURCE=env
# Route the widened pass through fundamental_fetch_state so a ~3.3-hour pass
# survives a restart. Without it the pass re-walks the universe every tick.
# Which slice of the universe the widened metrics pass covers.
#   selected  the pilot draw only (universe_symbols.backfill_selected) — ~450
#             symbols, ~15 min at the shared 1 req/sec Finnhub budget
#   eligible  the full §3.1 eligible universe — ~4,975 symbols, ~3.3 hours
#
# Defaults to 'selected' because Step 7 evaluates the draw and nothing else, so
# the wide pass would spend hours on ~4,500 symbols that take no part in the
# evaluation. Widen only once the pilot has shown the scoring approach is worth
# extending — the same sequencing §2.2 applies to paying for data.
#
# Restricts BOTH symbol resolution and checkpoint seeding: scoping only the
# former would leave ~4,500 permanently-pending rows that the checkpointed pass
# would work through anyway. An unrecognised value is an error, not a fallback.
FUNDAMENTAL_METRICS_SCOPE=selected
FUNDAMENTAL_METRICS_UNIVERSE_CHECKPOINTED=true
# The widened pass gets its OWN cadence rather than inheriting
# DATA_FUNDAMENTAL_METRICS_POLL_INTERVAL (24h): at ~3.3h per pass, daily would
# spend ~23h of API budget a week, against §2.3/§8.1.2 which specify weekly.
FUNDAMENTAL_METRICS_UNIVERSE_POLL_INTERVAL=168h
# How stale a symbol's last SUCCESS may be before it is claimable again. This,
# not a reset job, is what makes the weekly cadence emergent.
FUNDAMENTAL_METRICS_UNIVERSE_REFRESH_INTERVAL=168h
FUNDAMENTAL_METRICS_UNIVERSE_BATCH_SIZE=250
# A claim older than this is treated as abandoned by a killed worker.
FUNDAMENTAL_METRICS_UNIVERSE_CLAIM_LEASE=30m
FUNDAMENTAL_METRICS_UNIVERSE_MAX_ATTEMPTS=3
FUNDAMENTAL_METRICS_UNIVERSE_IDLE_INTERVAL=1h

# ── data-universe — eligible US common-stock universe (§3.1, §8.1) ────────────
# Weekly symbol-list refresh + weekly sector/shares/market-cap refresh.
# Needs FINNHUB_API_KEY (declared above) for the symbol list; without it that
# pass is skipped with a warning and the worker keeps running.
UNIVERSE_ENABLE_SYMBOLS=true
UNIVERSE_ENABLE_FUNDAMENTALS=true
# Finnhub /stock/symbol exchange code. "US" returns the whole US listing in one call.
UNIVERSE_EXCHANGE=US
UNIVERSE_SYMBOLS_POLL_INTERVAL=168h
UNIVERSE_FUNDAMENTALS_POLL_INTERVAL=168h
UNIVERSE_STARTUP_DELAY_SECS=30

# §3.1 eligibility. Blank means "spec default", never "allow nothing".
# Types: strict common-stock reading. Add "ADR" / "REIT" here to widen — the
# spec names only common stock, so widening is a deliberate choice, not a fix.
UNIVERSE_ALLOWED_TYPES="Common Stock"
# MICs for NASDAQ (incl. tier codes), NYSE, NYSE American. ARCX (NYSE Arca) and
# every OTC venue are deliberately absent — §3.1 excludes OTC/pink sheets.
UNIVERSE_ALLOWED_MICS=XNAS,XNGS,XNMS,XNCM,XNYS,XASE
# Non-common share-class suffixes, matched after a '.' or '-'. Preferred series
# (-P, -PA, -PB, …) are handled by a prefix rule and need no entry here.
# Share-class letters (BRK.B) are intentionally NOT excluded.
UNIVERSE_EXCLUDED_SUFFIXES=W,WS,WT,U,UN,R,RT
# Finnhub occasionally omits the MIC. Default false: an unverifiable venue
# cannot satisfy an allowlist.
UNIVERSE_ALLOW_EMPTY_MIC=false

# §3.1/§3.2 minimum daily bars. 252, because §3.7's 52-week window reads
# high[t-251] and a complete window therefore needs 252 bars including today.
# Lowering this reintroduces silently truncated 52-week windows.
#
# Recorded and reported by data-universe but NOT used to set is_eligible — the
# backfill iterates the eligible set, so gating eligibility on bar count would be
# circular. Enforced as a hard gate at scan time instead (§3.2).
UNIVERSE_MIN_BARS_HISTORY=252

# Which equity_ohlcv rows count as the scanner's daily bars (§7).
# Yahoo, not Alpaca: Alpaca's free tier is IEX-only volume, a single-venue
# fraction of consolidated volume, which would make RVOL, volume acceleration
# and dollar volume all wrong.
UNIVERSE_BAR_INTERVAL=1Day
# Which provider fills equity_ohlcv, and simultaneously the source value the
# scanner reads back by — one setting, so a provider swap cannot leave the reader
# filtering on a source nobody writes. An unrecognised value fails at startup.
#
#   twelve_data    PRIMARY. split+dividend adjusted, but ONLY with adjust=all,
#                  which the adapter always sends. Volume is split-adjusted in
#                  both modes — verified against NVDA's 2024-06-10 10:1 split
#                  (412,386,000 vs Tiingo's raw 41,238,580 = exactly 10.0000x),
#                  because a provider that rescales OHLC but not volume would
#                  silently corrupt RVOL for every symbol that ever split.
#                  8 credits/min measured, 800/day, no unique-symbol cap.
#                  450 symbols ~= 56 minutes.
#   tiingo         CROSS-VALIDATION ONLY. Equally correct (agrees with
#                  twelve_data to -0.0028% on close, +0.0000% on volume) but
#                  capped at 50 requests per CLOCK HOUR, so the same 450-symbol
#                  backfill takes ~9 hours. Kept to verify the primary, not to
#                  feed the pilot.
#   yahoo_finance  NOT dividend-adjusted (indicators.adjclose is never decoded),
#                  so it does not satisfy §3. Retained only because
#                  data-technical already writes rows under this source.
UNIVERSE_BAR_SOURCE=tiingo

# ── Tiingo: PRIMARY bar provider ─────────────────────────────────────────────
# Chosen for CORRECTNESS, not speed. It is the only source verified to apply one
# consistent adjustment factor across a whole series. twelve_data is 9x faster
# but alternates between adjusted and unadjusted bars WITHIN a single response,
# fabricating one-day moves up to +1382% across 12-17% of symbols and 41% of the
# penny bucket (see internal/barquality and `go run ./cmd/bar-audit`).
#
# Published and measured limits (Tiingo Starter, free):
#   50 requests / hour   HARD, resets on the clock hour (measured: blocked
#                        05:54 UTC, recovered 06:01 UTC -> fixed clock)
#   1,000 requests / day resets midnight EST
#   500 unique symbols / month  (re-reading a counted symbol is free)
#
# 50/hour = 0.013889/sec. This is the true throughput ceiling: a 450-symbol
# backfill takes ~9 hours and NO value here shortens it — a higher number just
# converts the wait into 429s, which is exactly what happened at 1.5/sec.
TIINGO_SHARED_RATE_ENABLE=true
TIINGO_RATE_PER_SEC=0.0138
TIINGO_RATE_BURST=1.0
TIINGO_RATE_DAILY_LIMIT=1000

# ── Bar-fetch HTTP knobs (apply to whichever UNIVERSE_BAR_SOURCE names) ──────
# Previously named UNIVERSE_YAHOO_*, which is how Twelve Data silently inherited
# Yahoo's 30s timeout and failed 12 symbols on "Client.Timeout exceeded while
# awaiting headers" — a 3-year daily response is ~100KB and this link is lossy.
# The UNIVERSE_YAHOO_* names still work as fallbacks.
UNIVERSE_BAR_TIMEOUT=90s
UNIVERSE_BAR_MAX_RETRIES=3
UNIVERSE_BAR_BACKOFF_BASE=2s
UNIVERSE_BAR_BACKOFF_MAX=60s
UNIVERSE_BAR_BURST=1
# Per-provider pacing lives in TWELVE_DATA_RATE_PER_SEC / TIINGO_RATE_PER_SEC;
# this generic value applies only to yahoo_finance.
UNIVERSE_BAR_REQUESTS_PER_SEC=2.0

# ── Momentum alert thresholds — CALIBRATED, not carried over (§4.4) ──────────
# The original 60/100 was set against §4 v1's weight table, where breakout and
# high52w contributed up to 25 points. Under v2 those are zeroed, the allocated
# ceiling is 90, and the practical ceiling is 75 while catalyst_tier is null —
# so 60 no longer means what it meant.
#
# Measured against the 218 historical pilot candidates, 60 fires on 34.4% of
# them (the 66th percentile) for a lift of only 1.20x. In the penny bucket it is
# worse than useless: penny's median score is 62, so >=60 selects candidates that
# hit LESS often than the penny base rate (0.91x lift).
#
# Thresholds are therefore per bucket, set at each bucket's own 90th percentile:
#
#   bucket   base rate   median   p90   n>=p90   hit%    lift
#   market   10.30%      53       65    21       14.29   1.39x
#   penny    32.08%      62       72     9       44.44   1.39x
#
# ~30 alerts over 18 months of pilot history, i.e. under two a month, which is a
# scanner rather than a feed.
#
# IN-SAMPLE: these percentiles come from the same candidates §4.1 v2 was derived
# from. Recalibrate when the universe widens.

# ── Momentum scanner channels (§8.3) ─────────────────────────────────────────
# Four channels: bucket x side. An unset ID logs a warning and posts nothing —
# it never crashes the bot, and a partial rollout (market configured, penny not)
# is a normal intermediate state.
DISCORD_PENNY_BUY_CHANNEL_ID=
DISCORD_PENNY_SELL_CHANNEL_ID=
DISCORD_MARKET_BUY_CHANNEL_ID=
DISCORD_MARKET_SELL_CHANNEL_ID=

# Off by default: momentum_score_100 is research-stage (only rvol is
# statistically validated), so posting to channels is an explicit opt-in rather
# than something that starts on upgrade.
BOT_MOMENTUM_SCAN_ENABLE=false

# §8.3: one alert per symbol per bucket per 5 sessions, so a name that stays
# qualified for a week does not alert daily.
BOT_MOMENTUM_COOLDOWN_SECS=432000

BOT_MOMENTUM_MIN_SCORE_MARKET=65
BOT_MOMENTUM_MIN_SCORE_PENNY=72

# ── Pilot subset (§2.2, migration 010) ───────────────────────────────────────
# The pilot validates Steps 4-7 end to end on a free tier before paying to
# backfill ~4,978 symbols on a score with no demonstrated edge yet.
UNIVERSE_SUBSET_ENABLE=false
# stratified | random | explicit
#
# 'stratified' draws randomly WITHIN §3.2's price buckets with a floor on the
# penny bucket. 'random' is unbiased but leaves the penny share to chance: at a
# ~9% sampling rate (450 of 4,978) a penny-poor universe can yield almost none,
# leaving §3.2's penny thresholds unexercised and §6's base rate computable for
# one bucket only. 'explicit' is for reproducing a named run — NOT suitable for
# §6, since hand-picking biases the sample in an unknown direction.
UNIVERSE_SUBSET_STRATEGY=stratified
UNIVERSE_SUBSET_SIZE=450
# Minimum share drawn from the penny bucket, e.g. 0.20 = 20% (~90 of 450).
UNIVERSE_SUBSET_PENNY_FLOOR_PCT=0.20
UNIVERSE_SUBSET_PENNY_MIN_PRICE=0.30
UNIVERSE_SUBSET_PENNY_MAX_PRICE=2.00
# Set this for any draw whose numbers you intend to cite; empty means a different
# sample each run. Seeding hashes md5(seed || symbol) rather than using
# setseed(), which fixes the sequence of random values but not which row receives
# which — so marking rows reshuffles a setseed-based sample.
UNIVERSE_SUBSET_SEED=
# Only for UNIVERSE_SUBSET_STRATEGY=explicit.
UNIVERSE_SUBSET_SYMBOLS=
# Redrawing is opt-in. UNIVERSE_SUBSET_ENABLE means "restrict work to the pilot
# subset" and stays on for the whole pilot; without this separate flag every
# restart reselected. With a fixed seed that is only wasted work, but with an
# empty seed it silently draws a DIFFERENT sample and spends a second batch of
# Tiingo's 500 unique symbols/month — and the row count is 450 either way.
UNIVERSE_SUBSET_RESELECT=false

# ── Universe pricing: the bucketing signal for stratification (§8.1.1) ───────
# Stratifying buckets symbols by price, and prices normally come from the
# backfill that the selection chooses — a circular dependency. It is broken with
# Finnhub /quote rather than by drawing twice from the bar provider: two draws
# would spend ~550 of Tiingo's 500-unique-symbols/month allowance, AND the
# bootstrap sample and the final sample come from different random processes, so
# nothing guarantees the first draw's bucket boundaries generalise before the
# real selection is committed.
#
# Finnhub /quote is already integrated and already paced through api_rate_budget,
# so this costs zero bar-provider symbols: ~83 minutes for ~4,978 symbols at the
# 1 req/sec Finnhub budget, once. Run it before the subset draw.
#
# CAVEAT, accepted and monitored: /quote is a live snapshot, not the adjusted
# close the bar provider later serves, so a few borderline symbols ($1.98 vs
# $2.02) can change bucket once real bars land. LoadSubsetStats compares the
# selection-time bucket against the post-backfill bucket and warns with examples.
UNIVERSE_PRICING_ENABLE=false
# Where that signal lives. Deliberately distinct from UNIVERSE_BAR_* so pricing
# the universe never touches bar-provider quota.
UNIVERSE_PRICE_INTERVAL=quote_snapshot
UNIVERSE_PRICE_SOURCE=finnhub_quote

# ── data-universe — resumable bar backfill (§8.1.3) + daily refresh (§8.1.4) ──
UNIVERSE_ENABLE_BACKFILL=true
UNIVERSE_ENABLE_DAILY_BARS=true

# History depth. 3 years per §2.3.
UNIVERSE_BACKFILL_YEARS=3
# Symbols claimed per round. Bounded so a crash loses at most one batch of
# in-flight claims and so progress is logged regularly across a long run.
UNIVERSE_BACKFILL_BATCH_SIZE=200
# Parallel in-flight fetches. The rate limiter is shared, so this controls
# pipelining, not throughput — raising it will not exceed the rate below.
UNIVERSE_BACKFILL_CONCURRENCY=4
# How long an in_progress claim is honoured before another round may reclaim it.
# This is what makes a killed worker's rows recoverable instead of stranded.
UNIVERSE_BACKFILL_CLAIM_LEASE=15m
# Retries per symbol across runs. Beyond this the symbol stays 'failed' and is
# reported rather than retried forever — check backfill_last_error.
UNIVERSE_BACKFILL_MAX_ATTEMPTS=3
# Wait before re-checking for work once a round finds none.
UNIVERSE_BACKFILL_IDLE_INTERVAL=1h

# Yahoo request behaviour. §2.3 budgets ~5 req/s, but the chart endpoint is
# unofficial and §2.2 says to rate-limit politely and treat it as best-effort.
# 2/s sustains a ~6k-symbol pass in well under an hour; above ~5/s expect 429s.
UNIVERSE_YAHOO_REQUESTS_PER_SEC=2.0
UNIVERSE_YAHOO_BURST=1
UNIVERSE_YAHOO_TIMEOUT=30s
UNIVERSE_YAHOO_MAX_RETRIES=3
UNIVERSE_YAHOO_BACKOFF_BASE=2s
UNIVERSE_YAHOO_BACKOFF_MAX=60s

# Daily incremental refresh. Runs on a plain interval — the worker has no market
# calendar, so a run on a holiday simply returns no new bars. The lookback is
# wider than one day on purpose: it repairs gaps from a missed run or a late
# provider correction, and upserts make the overlap free.
UNIVERSE_DAILY_BARS_INTERVAL=24h
UNIVERSE_DAILY_BARS_LOOKBACK_DAYS=7
