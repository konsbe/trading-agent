{
  "name": "@trading-agent/shared-components",
  "version": "1.0.0",
  "description": "Shared UI primitives, theme tokens and MFE utilities for trading-agent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme/theme.css",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run copy-css && npm run copy-assets",
    "copy-css": "find src -name '*.css' | while read file; do target=\"dist/${file#src/}\"; mkdir -p \"$(dirname \"$target\")\"; cp \"$file\" \"$target\"; done",
    "copy-assets": "find src -name '*.svg' | while read file; do target=\"dist/${file#src/}\"; mkdir -p \"$(dirname \"$target\")\"; cp \"$file\" \"$target\"; done",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "trading-agent",
    "shared",
    "components",
    "sse",
    "react"
  ],
  "author": "trading-agent",
  "license": "UNLICENSED",
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dnd": ">=11.1.3",
    "react-dnd-html5-backend": ">=11.1.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "cpx": "^1.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
