{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "Momentum Scanner Design Tokens",
  "version": "1.0.0",
  "description": "Unified design tokens for Momentum Scanner trading research dashboard in both Light and Dark themes.",
  "themes": {
    "light": {
      "name": "Momentum Scanner Light",
      "color_mode": "LIGHT",
      "font": "INTER",
      "roundness": "ROUND_FOUR",
      "custom_color": "#0284c7",
      "color": {
        "surface": { "value": "#faf8ff", "type": "color", "description": "Global viewport and backdrop" },
        "surface-dim": { "value": "#d2d9f4", "type": "color", "description": "Recessed areas / backdrop beneath elevated layers" },
        "surface-bright": { "value": "#faf8ff", "type": "color", "description": "Highlighted surface" },
        "surface-container-lowest": { "value": "#ffffff", "type": "color", "description": "Base canvas / lowest elevation card background" },
        "surface-container-low": { "value": "#f2f3ff", "type": "color", "description": "First container tier (table rows, metric cards)" },
        "surface-container": { "value": "#e9edff", "type": "color", "description": "Standard card container body" },
        "surface-container-high": { "value": "#e1e5fb", "type": "color", "description": "Elevated cards, hovered rows, search input" },
        "surface-container-highest": { "value": "#d9def4", "type": "color", "description": "Top-level popovers and active segment pills" },
        "surface-variant": { "value": "#dce2f9", "type": "color", "description": "Secondary groupings and chip fills" },
        "on-surface": { "value": "#151b2c", "type": "color", "description": "Primary typography, tickers, and values" },
        "on-surface-variant": { "value": "#404659", "type": "color", "description": "Secondary labels and descriptors" },
        "outline": { "value": "#70778b", "type": "color", "description": "Interactive borders and search stroke" },
        "outline-variant": { "value": "#c0c6de", "type": "color", "description": "Subtle dividers, row separators, grid lines" },
        "primary": { "value": "#0284c7", "type": "color", "description": "Sky 600 - Primary actions and active indicators" },
        "on-primary": { "value": "#ffffff", "type": "color", "description": "Text/icons on primary surfaces" },
        "primary-container": { "value": "#c2e8ff", "type": "color", "description": "Tinted pill background and active filter fills" },
        "on-primary-container": { "value": "#001e2c", "type": "color", "description": "Text/icons on primary container" },
        "secondary": { "value": "#0d9488", "type": "color", "description": "Teal 600 - Live telemetry badges and status pulses" },
        "on-secondary": { "value": "#ffffff", "type": "color", "description": "Text/icons on secondary surfaces" },
        "secondary-container": { "value": "#8bf7be", "type": "color", "description": "Telemetry container background" },
        "on-secondary-container": { "value": "#002113", "type": "color", "description": "Text/icons on secondary container" },
        "tertiary": { "value": "#d97706", "type": "color", "description": "Amber 600 - Disclaimer pill 'Screener — not a forecast'" },
        "on-tertiary": { "value": "#ffffff", "type": "color", "description": "Text/icons on tertiary surfaces" },
        "tertiary-container": { "value": "#ffddb3", "type": "color", "description": "Disclaimer pill container fill" },
        "on-tertiary-container": { "value": "#2b1700", "type": "color", "description": "Text on disclaimer banner" },
        "error": { "value": "#dc2626", "type": "color", "description": "Red 600 - System alerts and feed disconnects" },
        "on-error": { "value": "#ffffff", "type": "color", "description": "Text on error surfaces" },
        "error-container": { "value": "#ffdad6", "type": "color", "description": "Error banner/card background" },
        "on-error-container": { "value": "#410002", "type": "color", "description": "Text on error containers" }
      }
    },
    "dark": {
      "name": "Momentum Scanner",
      "color_mode": "DARK",
      "font": "INTER",
      "roundness": "ROUND_FOUR",
      "custom_color": "#0ea5e9",
      "color": {
        "surface": { "value": "#101419", "type": "color", "description": "Obsidian base viewport and backdrop" },
        "surface-dim": { "value": "#101419", "type": "color", "description": "Recessed areas / backdrop beneath elevated layers" },
        "surface-bright": { "value": "#353940", "type": "color", "description": "Highlighted surface / active sheen" },
