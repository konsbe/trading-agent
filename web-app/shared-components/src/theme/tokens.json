        "surface-container-low": { "value": "#181c22", "type": "color", "description": "First container tier (cards, table rows)" },
        "surface-container": { "value": "#1c2026", "type": "color", "description": "Standard card container body" },
        "surface-container-high": { "value": "#262b32", "type": "color", "description": "Elevated cards, hovered rows, search input" },
        "surface-container-highest": { "value": "#31363d", "type": "color", "description": "Top-level popovers and active segment pills" },
        "surface-variant": { "value": "#31363d", "type": "color", "description": "Secondary groupings and chip fills" },
        "on-surface": { "value": "#e0e2eb", "type": "color", "description": "Primary typography, tickers, and values" },
        "on-surface-variant": { "value": "#c1c7ce", "type": "color", "description": "Secondary labels and descriptors" },
        "outline": { "value": "#8b9198", "type": "color", "description": "Interactive borders and search stroke" },
        "outline-variant": { "value": "#41474d", "type": "color", "description": "Subtle dividers, row separators, grid lines" },
        "primary": { "value": "#0ea5e9", "type": "color", "description": "Sky 500 - Primary actions and active indicators" },
        "on-primary": { "value": "#003549", "type": "color", "description": "Text/icons on primary surfaces" },
        "primary-container": { "value": "#004d69", "type": "color", "description": "Tinted pill background and active filter fills" },
        "on-primary-container": { "value": "#c2e8ff", "type": "color", "description": "Text/icons on primary container" },
        "secondary": { "value": "#10b981", "type": "color", "description": "Emerald 500 - Live telemetry badges and status pulses" },
        "on-secondary": { "value": "#003822", "type": "color", "description": "Text/icons on secondary surfaces" },
        "secondary-container": { "value": "#005234", "type": "color", "description": "Telemetry container background" },
        "on-secondary-container": { "value": "#8bf7be", "type": "color", "description": "Text/icons on secondary container" },
        "tertiary": { "value": "#f59e0b", "type": "color", "description": "Amber 500 - Disclaimer pill 'Screener — not a forecast'" },
        "on-tertiary": { "value": "#452b00", "type": "color", "description": "Text/icons on tertiary surfaces" },
        "tertiary-container": { "value": "#633f00", "type": "color", "description": "Disclaimer pill container fill" },
        "on-tertiary-container": { "value": "#ffddb3", "type": "color", "description": "Text on disclaimer banner" },
        "error": { "value": "#ef4444", "type": "color", "description": "Red 500 - System alerts and feed disconnects" },
        "on-error": { "value": "#49000a", "type": "color", "description": "Text on error surfaces" },
        "error-container": { "value": "#680012", "type": "color", "description": "Error banner/card background" },
        "on-error-container": { "value": "#ffdadb", "type": "color", "description": "Text on error containers" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "headline": { "value": "Inter, sans-serif", "type": "fontFamily" },
      "body": { "value": "Inter, sans-serif", "type": "fontFamily" },
      "label": { "value": "JetBrains Mono, monospace", "type": "fontFamily" }
    }
  },
  "rules": [
    "Green and red are strictly reserved for actual price movement delta and not used in UI chrome.",
    "Disclaimer pill 'Screener — not a forecast' uses the tertiary/warning amber palette and remains persistent across all screens.",
    "Dark theme utilizes 500-level vibrant tints against dark obsidian backdrops to prevent halation.",
    "Light theme utilizes 600-level saturated tints against clean white/off-white backdrops for strict WCAG AA contrast (>= 4.5:1)."
  ]
}
