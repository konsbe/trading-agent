{
    "compilerOptions": {
        "target": "ES6",
        "module": "ESNext",
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "ignoreDeprecations": "6.0",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "jest",
            "node",
            "@testing-library/jest-dom"
        ],
        "resolveJsonModule": true,
        "allowJs": true,
        "isolatedModules": true,
        "noEmit": true,
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "baseUrl": ".",
        "paths": {
            "@common/*": ["src/common/*"],
            "@components/*": ["src/components/*"],
            "@constants/*": ["src/constants/*"],
            "@styles/*": ["src/styles/*"],
            "@layouts/*": ["src/layouts/*"],
            "@trading-agent/shared-components": ["../shared-components/src/shell.ts"],
            "react": ["./node_modules/@types/react"],
            "react/*": ["./node_modules/@types/react/*"]
        }
    },
    "include": [
        "src",
        "src/types/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "./tests",
        "**/*.test.*"
    ]
}
