{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": false,
    "noResolve": false,
    "types": [
      "jest",
      "node",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src/**/*",
    "src/types.d.ts",
    "__mocks__/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}